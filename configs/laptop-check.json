{
  "seed": 42,
  "device": "auto",
  "vocab_size": 6400,
  "block_size": 256,
  "model": {
    "hidden_size": 512,
    "num_hidden_layers": 8,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "intermediate_size": 1408,
    "max_position_embeddings": 2048
  },
  "batch_size": 2,
  "gradient_accumulation_steps": 8,
  "pretrain_steps": 2,
  "sft_steps": 2,
  "dpo_steps": 2,
  "lora_steps": 2,
  "pretrain_lr": 0.0003,
  "sft_lr": 5e-05,
  "dpo_lr": 5e-06,
  "lora_lr": 0.0002,
  "save_steps": 1,
  "eval_steps": 1,
  "eval_batches": 2,
  "warmup_ratio": 0.03,
  "weight_decay": 0.1,
  "max_grad_norm": 1.0,
  "lora_r": 8,
  "lora_alpha": 16,
  "dpo_beta": 0.1
}